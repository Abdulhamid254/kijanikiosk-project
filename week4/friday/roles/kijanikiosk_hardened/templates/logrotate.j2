/opt/kijanikiosk/{{ server_role }}/*.log {
    {{ logrotate_frequency }}
    rotate {{ logrotate_retention_count }}
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        /usr/bin/systemctl reload kijanikiosk-{{ server_role }}.service > /dev/null 2>&1 || true
    endscript
}
