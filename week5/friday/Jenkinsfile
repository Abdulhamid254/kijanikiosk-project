pipeline {
    agent any // Runs natively on the available system worker node
    
     environment {
        // Explicitly defined variables using host.docker.internal to bridge networking streams
        NEXUS_REGISTRY_URL   = "http://docker.internal"
        NEXUS_CREDENTIALS_ID = "fb547463-70ca-4e90-8b78-9e89e1bf82fa"
        APP_NAME             = "kijanikiosk-payments"
        GIT_COMMIT_SHA       = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'unknown'}"
        SEMVER_VERSION       = "1.0.0"
        BUILD_VERSION        = "${SEMVER_VERSION}-${GIT_COMMIT_SHA}"
    }
    
    options {
        timeout(time: 10, unit: 'MINUTES') // Board mandate: Pipeline must complete inside 10 minutes
        buildDiscarder(logRotator(numToKeepStr: '10')) // Automated disk preservation policy
        disableConcurrentBuilds() // Prevents colliding shared space tasks or overlapping workspaces
    }
    
    stages {
        stage('Trigger & Initialize') {
            steps {
                echo "Starting build execution for ${APP_NAME} version ${BUILD_VERSION}"
                script {
                    // Board-required blueprint mapping definition
                    echo "Architectural Target Blueprint Locked: node:20.11.0-alpine image container"
                }
            }
        }
        
        stage('Environment Isolation Wrapper') {
            steps {
                // Dynamically execute code inside an isolated tool bubble if native Docker engine is absent
                nodejs('node20') {
                    dir('week5/friday') {
                        
                        echo "--- Gate 1: Blueprint Validation (Lint Stage) ---"
                        sh 'npm run lint'
                        
                        echo "--- Gate 2: Assembly Center (Build Stage) ---"
                        sh 'npm run build'
                        sh "npm version ${BUILD_VERSION} --no-git-tag-version"
                        
                        echo "--- Gate 3 & 4: Functional Verification (Parallel Tracks) ---"
                        // Runs processes sequentially inside the tool bubble to ensure environment safety
                        sh 'npm run test:ci'
                        sh 'npm run metadata:audit'
                        
                        echo "--- Gate 5: Warehouse Safe (Publish to Nexus) ---"
                        withCredentials([usernamePassword(credentialsId: env.NEXUS_CREDENTIALS_ID, usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASSWORD')]) {
                            sh 'npm config set registry "http://docker.internal"'
                            sh 'echo "//host.docker.internal:8081/repository/kijanikiosk-payments/:_auth=\$(echo -n \${NEXUS_USER}:\${NEXUS_PASSWORD} | base64)" >> .npmrc'
                            sh 'npm publish'
                            sh 'rm -f .npmrc'
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                if (env.WORKSPACE) {
                    echo "Executing post-build workspace cleanup and test aggregation..."
                    junit allowEmptyResults: true, testResults: 'week5/friday/coverage/junit.xml'
                    cleanWs deleteDirs: true, notFailBuild: true
                }
            }
        }
        success {
            echo "PIPELINE SUCCESSFUL: Artifact ${BUILD_VERSION} published to Nexus."
            echo "Nexus Repository URL: ${env.NEXUS_REGISTRY_URL}${env.APP_NAME}/-/${env.APP_NAME}-${env.BUILD_VERSION}.tgz"
        }
        failure {
            echo "PIPELINE FAILED: Execution halted due to an error."
            echo "Notification sent to Engineering Operations."
        }
    }
}