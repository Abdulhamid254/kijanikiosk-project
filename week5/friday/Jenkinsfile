pipeline {
    agent any // Runs natively on the host machine since the host OS lacks Docker
    
    tools {
        nodejs 'node20' // Dynamically fetches and configures Node.js/npm for the PATH environment
    }
    
    
    environment {
        // Explicitly defined environment variables to prevent configuration drift
        NEXUS_REGISTRY_URL = "http://localhost:8081/repository/kijanikiosk-payments/"
        NEXUS_CREDENTIALS_ID = "fb547463-70ca-4e90-8b78-9e89e1bf82fa"
        APP_NAME = "kijanikiosk-payments"
        GIT_COMMIT_SHA = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'unknown'}"
        SEMVER_VERSION = "1.0.0"
        BUILD_VERSION = "${SEMVER_VERSION}-${GIT_COMMIT_SHA}"
    }
    
    options {
        timeout(time: 10, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        //ansiColor('xterm')
    }
    
    stages {
        stage('Trigger & Initialize') {
            steps {
                echo "Starting build execution for ${APP_NAME} version ${BUILD_VERSION}"
            }
        }
       stage('Lint') {
            steps {
                echo "Executing static code analysis..."
                // Step inside the folder where the package.json file actually lives
                dir('week5/friday') {
                    sh 'npm run lint'
                }
            }
        }
        
        stage('Build') {
            steps {
                echo "Compiling application source..."
                dir('week5/friday') {
                    sh 'npm run build'
                    sh "npm version ${BUILD_VERSION} --no-git-tag-version"
                }
            }
        }
        stage('Parallel Verify') {
            parallel {
                stage('Unit & Integration Tests') {
                    steps {
                        echo "Running automated test suites..."
                        dir('week5/friday') {
                            sh 'npm run test:ci'
                        }
                    }
                }
                stage('Security Audit') {
                    steps {
                        echo "Scanning dependencies for known vulnerabilities..."
                        dir('week5/friday') {
                            sh 'npm run metadata:audit'
                        }
                    }
                }
            }
        }
        
        stage('Archive') {
            steps {
                echo "Fingerprinting and archiving build artifacts locally..."
                // Point target collection explicitly to the subfolder path
                archiveArtifacts artifacts: 'week5/friday/dist/**/*.js, week5/friday/package.json', fingerprint: true, allowEmptyArchive: false
            }
        }
        
        stage('Publish to Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.NEXUS_CREDENTIALS_ID, usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASSWORD')]) {
                    dir('week5/friday') {
                        sh """
                            echo "registry=${env.NEXUS_REGISTRY_URL}" > .npmrc
                            echo "//localhost:8081/repository/kijanikiosk-payments/:_auth=\$(echo -n '\${NEXUS_USER}:\${NEXUS_PASSWORD}' | base64)" >> .npmrc
                            npm publish
                            rm -f .npmrc
                        """
                    }
                }
            }
        }
    }
    
    post {
         always {
            script {
                if (env.WORKSPACE) {
                    echo "Executing post-build workspace cleanup and test aggregation..."
                    junit allowEmptyResults: true, testResults: 'week5/friday/coverage/junit.xml'
                    cleanWs deleteDirs: true, notFailBuild: true
                }
            }
        }
        success {
            echo "PIPELINE SUCCESSFUL: Artifact ${BUILD_VERSION} published to Nexus."
            echo "Nexus Repository URL: ${env.NEXUS_REGISTRY_URL}${env.APP_NAME}/-/${env.APP_NAME}-${env.BUILD_VERSION}.tgz"
        }
        failure {
            echo "PIPELINE FAILED: Execution halted due to an error."
            echo "Notification sent to Engineering Operations."
        }
        changed {
            echo "Pipeline status transitioned from ${currentBuild.previousBuild?.result} to ${currentBuild.currentResult}"
        }
    }
}

      